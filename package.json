{
  "name": "atelier-lune-shipping",
  "private": true,
  "description": "Atelier Lune's internal shipping dashboard, built on the Colistra SDK.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @atelier-lune/dashboard",
    "build": "npm run build -w @atelier-lune/dashboard",
    "preview": "npm run preview -w @atelier-lune/dashboard",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @atelier-lune/dashboard"
  }
}
